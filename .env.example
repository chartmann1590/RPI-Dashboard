# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key

# Google Calendar
GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com

# Home Assistant
HA_URL=https://your-homeassistant-url.com
HA_TOKEN=your_long_lived_access_token

# SwitchBot API
SWITCHBOT_TOKEN=your_switchbot_token
SWITCHBOT_SECRET=your_switchbot_secret
SWITCHBOT_LOCK_IDS=LOCK_ID_1,LOCK_ID_2

# ROMM (ROM Manager)
ROMM_URL=http://your-romm-server:port
ROMM_USERNAME=your_username
ROMM_PASSWORD=your_password

# RetroAchievements
RETROACHIEVEMENTS_API_KEY=your_retroachievements_api_key
RETROACHIEVEMENTS_USERNAME=your_username

# News API
NEWS_API_KEY=your_newsapi_key

# Timezone
TIMEZONE=America/New_York
